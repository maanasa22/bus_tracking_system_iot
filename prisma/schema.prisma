generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ============================================
// AUTH & USERS
// ============================================

model User {
  id            String    @id @default(cuid())
  name          String
  email         String    @unique
  passwordHash  String
  role          String    @default("STUDENT") // SUPERADMIN, ADMIN, DRIVER, STUDENT
  avatar        String?
  phone         String?
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  driverProfile Driver?
  studentProfile Student?
  sessions      Session[]
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ============================================
// DRIVER & STUDENT PROFILES
// ============================================

model Driver {
  id         String     @id @default(cuid())
  licenseNo  String     @unique
  userId     String     @unique
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  busId      String?
  bus        Bus?       @relation(fields: [busId], references: [id])
  schedules  Schedule[]
  createdAt  DateTime   @default(now())
}

model Student {
  id           String        @id @default(cuid())
  rollNo       String        @unique
  userId       String        @unique
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  stopId       String?
  assignedStop Stop?         @relation(fields: [stopId], references: [id])
  stopRequests StopRequest[]
  createdAt    DateTime      @default(now())
}

// ============================================
// FLEET - BUSES
// ============================================

model Bus {
  id           String   @id @default(cuid())
  busId        String   @unique  // BUS-001
  numberPlate  String   @unique  // KA-01-AB-1234
  capacity     Int      @default(52)
  model        String?
  year         Int?
  status       String   @default("IDLE")  // ACTIVE, IDLE, DELAYED, MAINTENANCE, OUT_OF_SERVICE
  currentLat   Float?
  currentLng   Float?
  currentSpeed Float    @default(0)
  heading      Float    @default(0)
  passengers   Int      @default(0)
  routeId      String?
  route        Route?   @relation(fields: [routeId], references: [id])
  drivers      Driver[]
  device       Device?
  trips        Trip[]
  alerts       Alert[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// ============================================
// ROUTES & STOPS
// ============================================

model Route {
  id          String     @id @default(cuid())
  name        String     // "Route A"
  description String?    // "North Campus"
  color       String     @default("#6366f1")
  distance    Float?     // km
  duration    Int?       // minutes estimated
  status      String     @default("ACTIVE") // ACTIVE, INACTIVE, SUSPENDED
  stops       Stop[]
  buses       Bus[]
  trips       Trip[]
  schedules   Schedule[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

model Stop {
  id           String        @id @default(cuid())
  name         String
  lat          Float
  lng          Float
  order        Int           // sequence within route
  routeId      String
  route        Route         @relation(fields: [routeId], references: [id], onDelete: Cascade)
  students     Student[]
  stopRequests StopRequest[]
}

// ============================================
// TRIPS & TRACKING
// ============================================

model Trip {
  id         String    @id @default(cuid())
  busId      String
  bus        Bus       @relation(fields: [busId], references: [id])
  routeId    String
  route      Route     @relation(fields: [routeId], references: [id])
  startTime  DateTime  @default(now())
  endTime    DateTime?
  status     String    @default("IN_PROGRESS") // IN_PROGRESS, COMPLETED, CANCELLED
  passengers Int       @default(0)
  distance   Float?
  onTime     Boolean   @default(true)
  createdAt  DateTime  @default(now())
}

model StopRequest {
  id         String   @id @default(cuid())
  studentId  String
  student    Student  @relation(fields: [studentId], references: [id])
  stopId     String
  stop       Stop     @relation(fields: [stopId], references: [id])
  studentLat Float
  studentLng Float
  status     String   @default("PENDING") // PENDING, ACKNOWLEDGED, COMPLETED, EXPIRED
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

// ============================================
// IOT DEVICES
// ============================================

model Device {
  id        String    @id @default(cuid())
  deviceId  String    @unique  // DEV-001
  busId     String    @unique
  bus       Bus       @relation(fields: [busId], references: [id])
  firmware  String    @default("v2.4.1")
  status    String    @default("OFFLINE") // ONLINE, OFFLINE, WARNING
  battery   Float     @default(100)
  signal    Int       @default(0) // 0-4
  lastPing  DateTime?
  uptime    Float     @default(0) // percentage
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

// ============================================
// ALERTS & NOTIFICATIONS
// ============================================

model Alert {
  id           String   @id @default(cuid())
  type         String   // SPEED, GEOFENCE, DEVICE, ROUTE, MAINTENANCE, SOS
  severity     String   // CRITICAL, WARNING, INFO, SUCCESS
  title        String
  message      String
  busId        String?
  bus          Bus?     @relation(fields: [busId], references: [id])
  acknowledged Boolean  @default(false)
  createdAt    DateTime @default(now())
}

// ============================================
// SCHEDULES
// ============================================

model Schedule {
  id        String   @id @default(cuid())
  routeId   String
  route     Route    @relation(fields: [routeId], references: [id])
  driverId  String?
  driver    Driver?  @relation(fields: [driverId], references: [id])
  dayOfWeek Int      // 0=Sunday, 1=Monday, ... 6=Saturday
  startTime String   // "06:30"
  endTime   String   // "09:30"
  shiftType String   @default("MORNING") // MORNING, AFTERNOON, EVENING, SPECIAL
  createdAt DateTime @default(now())
}
